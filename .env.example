# Backend (Supabase) connection settings.
# Fill these in with the values from your own Supabase project.

# Used by the browser app
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Used by the server (API routes)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Server-only, never expose to the browser.
# Needed by the admin/access-control and data API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
